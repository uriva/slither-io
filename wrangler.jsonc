{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slither-io",
  "compatibility_date": "2026-04-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "slither-io.uriv.me",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
